MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=it_website
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

SITE_URL=https://your-domain.example
VITE_SITE_URL=https://your-domain.example

# Production (NODE_ENV=production). Register the redirect URI on the production app.
MICROSOFT_CLIENT_ID=MICROSOFT_DEV_CLIENT_ID
MICROSOFT_CLIENT_SECRET=MICROSOFT_DEV_CLIENT_SECRET
MICROSOFT_TENANT_ID=MICROSOFT_DEV_TENANT_ID
MICROSOFT_REDIRECT_URI=MICROSOFT_DEV_REDIRECT_URI
MICROSOFT_ALLOWED_DOMAIN=MICROSOFT_DEV_ALLOWED_DOMAIN

# Development (vite dev). Register the redirect URI on a separate app.
MICROSOFT_DEV_CLIENT_ID=
MICROSOFT_DEV_CLIENT_SECRET=
MICROSOFT_DEV_TENANT_ID=
MICROSOFT_DEV_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback
MICROSOFT_DEV_ALLOWED_DOMAIN=unikl.edu.my
